{
  "name": "omp-discord-bridge",
  "version": "0.1.0",
  "description": "Discord gateway daemon for persistent per-thread OMP agent sessions.",
  "type": "module",
  "bin": {
    "omp-discord-bridge": "./dist/src/daemon.js"
  },
  "omp": {
    "extensions": [
      "./dist/src/extension.js"
    ]
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./daemon": "./dist/src/daemon.js",
    "./extension": "./dist/src/extension.js"
  },
  "files": [
    "dist",
    "README.md",
    "examples",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/src/daemon.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.25.0",
    "discord.js": "^14.24.2",
    "ws": "^8.22.0",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "author": "Carter McAlister",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarterMcAlister/omp-discord-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/CarterMcAlister/omp-discord-bridge/issues"
  },
  "homepage": "https://github.com/CarterMcAlister/omp-discord-bridge#readme",
  "keywords": [
    "omp",
    "oh-my-pi",
    "discord",
    "bot",
    "agent",
    "acp",
    "agent-client-protocol"
  ],
  "overrides": {
    "tar": "^7.5.16"
  }
}
